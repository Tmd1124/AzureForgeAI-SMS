@page "/conversations"
@implements IDisposable
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject SmsMessenger.Core.ViewModels.ConversationsViewModel ViewModel
@inject SmsMessenger.Core.Services.IProfileService ProfileService
@inject SmsMessenger.Core.Services.IContactService ContactService
@inject SmsMessenger.Core.Services.IAppResumeNotifier AppResumeNotifier
@inject NavigationManager Nav

<div style="padding:12px;">
    @if (_selectedThreadIds.Count > 0)
    {
        <div style="display:flex;align-items:center;gap:2px;margin-bottom:8px;">
            <button @onclick="ClearSelection" style="width:36px;height:32px;border:none;background:transparent;font-size:1em;line-height:1;padding:0;">✕</button>
            <strong style="flex:1;">@_selectedThreadIds.Count selected</strong>
            <button @onclick="ToggleFavoriteSelectedThreads" style="width:36px;height:32px;border:none;background:transparent;font-size:1em;line-height:1;padding:0;">@(AllSelectedAreFavorited() ? "💔" : "❤️")</button>
            <button @onclick="ArchiveSelectedThreads" style="width:36px;height:32px;border:none;background:transparent;font-size:1em;line-height:1;padding:0;">📦</button>
            <button @onclick="TrashSelectedThreads" style="width:36px;height:32px;border:none;background:transparent;font-size:1em;line-height:1;padding:0;">🗑</button>
            @if (_selectedThreadIds.Count == 1)
            {
                <button @onclick="OpenOverflowForSingleSelection" style="width:36px;height:32px;border:none;background:transparent;font-size:1em;line-height:1;padding:0;">⋮</button>
            }
        </div>
    }
    else
    {
        <div style="display:flex;justify-content:flex-end;align-items:center;gap:10px;margin-bottom:8px;">
            <button @onclick="OpenSearch"
                    style="width:32px;height:32px;border-radius:50%;border:none;background:#e2e8f0;font-size:0.9em;padding:0;">
                🔍
            </button>
            @if (!string.IsNullOrEmpty(_photoDataUri))
            {
                <img @onclick="@(() => Nav.NavigateTo("/menu"))" src="@_photoDataUri"
                     style="width:32px;height:32px;border-radius:50%;object-fit:cover;" />
            }
            else
            {
                <button @onclick="@(() => Nav.NavigateTo("/menu"))"
                        style="width:32px;height:32px;border-radius:50%;border:none;background:#e2e8f0;font-size:0.9em;padding:0;">
                    ⚙
                </button>
            }
        </div>
    }

    @if (_isSearchOpen)
    {
        <div style="display:flex;align-items:center;gap:8px;background:var(--card-color);padding:12px;margin-bottom:8px;border-radius:8px;">
            <input @ref="_searchInput" placeholder="Search contacts or numbers" @bind="ViewModel.SearchText" @bind:event="oninput" style="flex:1;min-width:0;" />
            <button @onclick="CloseSearch" style="border:none;background:transparent;font-size:1.2em;">✕</button>
        </div>
    }

    @if (_isLoading)
    {
    }
    else if (ViewModel.Threads.Count == 0)
    {
        <p>No conversations yet.</p>
    }
    else
    {
        @foreach (var thread in ViewModel.Threads)
        {
            <div @onpointerdown="e => OnPointerDown(thread.Id, e)"
                 @onpointerup="e => OnPointerUp(thread.Id, thread.Address, e)"
                 @onpointermove="OnPointerMove"
                 @onpointerleave="CancelLongPress"
                 style="display:flex;align-items:center;gap:10px;padding:10px;border-bottom:1px solid #eee;touch-action:pan-y;user-select:none;-webkit-user-select:none;background:@RowBackground(thread);">
                @if (_selectedThreadIds.Count > 0)
                {
                    <div style="width:40px;height:40px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.3em;background:@(_selectedThreadIds.Contains(thread.Id) ? "var(--accent-color)" : "transparent");border:2px solid var(--accent-color);color:white;">
                        @(_selectedThreadIds.Contains(thread.Id) ? "✓" : "")
                    </div>
                }
                else if (!string.IsNullOrEmpty(thread.PhotoUri))
                {
                    <img src="@thread.PhotoUri" style="width:40px;height:40px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                }
                else if (!string.IsNullOrWhiteSpace(thread.DisplayName))
                {
                    <div style="width:40px;height:40px;border-radius:50%;background:var(--accent-color);color:white;display:flex;align-items:center;justify-content:center;flex-shrink:0;">@thread.Initials</div>
                }
                else
                {
                    <button @onclick="() => AddContact(thread.Address)" @onclick:stopPropagation="true"
                            @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true"
                            style="width:40px;height:40px;border-radius:50%;border:none;background:var(--accent-color);color:white;font-size:1.3em;flex-shrink:0;">
                        +
                    </button>
                }
                <div>
                    <strong>@thread.DisplayNameOrAddress</strong>
                    @if (thread.IsFavorite)
                    {
                        <span> ❤️</span>
                    }
                    @if (thread.UnreadCount > 0)
                    {
                        <span style="color:#06b6d4;"> ● @thread.UnreadCount</span>
                    }
                    <div style="color:#94a3b8;font-size:0.85em;">@thread.PreviewText</div>
                </div>
            </div>
        }
    }

    <button @onclick="@(() => Nav.NavigateTo("/compose"))"
            style="position:fixed;right:24px;bottom:24px;width:56px;height:56px;border-radius:50%;background:var(--accent-color);color:white;font-size:1.5em;border:none;">
        +
    </button>
</div>

@if (_actionSheetThreadId is not null)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.4);display:flex;align-items:flex-end;" @onclick="CloseActionSheet">
        <div style="background:var(--card-color);width:100%;padding:12px;" @onclick:stopPropagation="true">
            <div @onclick="FavoriteSelectedThread" style="padding:12px;">@(_actionSheetIsFavorite ? "💔 Unfavorite" : "❤️ Favorite")</div>
            <div @onclick="MarkReadSelectedThread" style="padding:12px;">@(_actionSheetIsUnread ? "✅ Mark as Read" : "📩 Mark as Unread")</div>
            <div @onclick="TrashSelectedThread" style="padding:12px;">🗑 Trash</div>
            <div @onclick="BlockSelectedThread" style="padding:12px;">🚫 Block</div>
        </div>
    </div>
}

@code {
    private long? _actionSheetThreadId;
    private string _actionSheetAddress = string.Empty;
    private bool _actionSheetIsFavorite;
    private bool _actionSheetIsUnread;
    private CancellationTokenSource? _longPressCts;
    private bool _longPressTriggered;
    private long? _activePointerDownThreadId;
    private double _pointerDownX;
    private const double SwipeThreshold = 80;
    private string? _photoDataUri;
    private bool _isSearchOpen;
    private bool _shouldFocusSearch;
    private ElementReference _searchInput;
    private bool _isLoading = true;
    private readonly HashSet<long> _selectedThreadIds = new();

    private string RowBackground(SmsMessenger.Core.Models.SmsThread thread)
    {
        if (_selectedThreadIds.Contains(thread.Id))
        {
            return "rgba(99,102,241,0.2)";
        }
        return thread.UnreadCount > 0 ? "rgba(234,179,8,0.15)" : "transparent";
    }

    protected override async Task OnInitializedAsync()
    {
        _photoDataUri = await ProfileService.GetProfilePhotoDataUriAsync();
        await ViewModel.LoadCommand.ExecuteAsync(null);
        _isLoading = false;
        AppResumeNotifier.Resumed += OnAppResumed;
    }

    private void OnAppResumed()
    {
        // A pointerdown on a row can be left "stuck" with no matching pointerup if this
        // activity loses foreground focus mid-gesture — e.g. the "+" avatar button launching
        // the native Add Contact screen. Without this reset, the next unrelated tap/scroll to
        // land on that same row would compute its swipe distance against the stale pointerdown
        // position and could be misread as a real swipe, incorrectly trashing or archiving it.
        _activePointerDownThreadId = null;
        _longPressCts?.Cancel();
        _longPressTriggered = false;

        _ = InvokeAsync(async () =>
        {
            await ViewModel.LoadCommand.ExecuteAsync(null);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AppResumeNotifier.Resumed -= OnAppResumed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocusSearch)
        {
            _shouldFocusSearch = false;
            await _searchInput.FocusAsync();
        }
    }

    private void OpenSearch()
    {
        if (_isSearchOpen)
        {
            CloseSearch();
            return;
        }
        _isSearchOpen = true;
        _shouldFocusSearch = true;
    }

    private void CloseSearch()
    {
        _isSearchOpen = false;
        ViewModel.SearchText = string.Empty;
    }

    private void OpenThread(long threadId, string address)
    {
        Nav.NavigateTo($"/conversations/thread?id={threadId}&address={Uri.EscapeDataString(address)}");
    }

    private void OnPointerDown(long threadId, PointerEventArgs e)
    {
        _activePointerDownThreadId = threadId;
        _pointerDownX = e.ClientX;
        _longPressTriggered = false;
        _longPressCts = new CancellationTokenSource();
        var token = _longPressCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(500, token);
                _longPressTriggered = true;
                await InvokeAsync(() =>
                {
                    _selectedThreadIds.Add(threadId);
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException)
            {
                // pointer released or left before the long-press threshold — a normal tap, not a long-press
            }
        });
    }

    private void CancelLongPress() => _longPressCts?.Cancel();

    private void OnPointerMove(PointerEventArgs e)
    {
        if (Math.Abs(e.ClientX - _pointerDownX) > 15)
        {
            CancelLongPress();
        }
    }

    private async Task OnPointerUp(long threadId, string address, PointerEventArgs e)
    {
        _longPressCts?.Cancel();
        if (_activePointerDownThreadId != threadId)
        {
            // pointerup with no matching pointerdown on this row (e.g. an overlay above it just closed
            // mid-gesture and the browser redelivered the release here) — not a real tap, ignore it.
            return;
        }
        _activePointerDownThreadId = null;
        if (_longPressTriggered)
        {
            return;
        }

        if (_selectedThreadIds.Count > 0)
        {
            // Already in selection mode: any tap toggles that row's checkbox instead of
            // opening the thread or triggering a swipe action.
            if (!_selectedThreadIds.Remove(threadId))
            {
                _selectedThreadIds.Add(threadId);
            }
            return;
        }

        var deltaX = e.ClientX - _pointerDownX;
        if (deltaX >= SwipeThreshold)
        {
            await ViewModel.TrashThreadCommand.ExecuteAsync(threadId);
            return;
        }
        if (deltaX <= -SwipeThreshold)
        {
            await ViewModel.ArchiveThreadCommand.ExecuteAsync(threadId);
            return;
        }

        OpenThread(threadId, address);
    }

    private void CloseActionSheet() => _actionSheetThreadId = null;

    private async Task TrashSelectedThread()
    {
        if (_actionSheetThreadId is long id)
        {
            await ViewModel.TrashThreadCommand.ExecuteAsync(id);
        }
        CloseActionSheet();
        ClearSelection();
    }

    private async Task BlockSelectedThread()
    {
        if (_actionSheetThreadId is not null)
        {
            await ViewModel.BlockThreadCommand.ExecuteAsync(_actionSheetAddress);
        }
        CloseActionSheet();
        ClearSelection();
    }

    private async Task FavoriteSelectedThread()
    {
        if (_actionSheetThreadId is long id)
        {
            await ViewModel.FavoriteThreadCommand.ExecuteAsync(id);
        }
        CloseActionSheet();
        ClearSelection();
    }

    private async Task MarkReadSelectedThread()
    {
        if (_actionSheetThreadId is long id)
        {
            await ViewModel.MarkThreadReadStateCommand.ExecuteAsync(id);
        }
        CloseActionSheet();
        ClearSelection();
    }

    private async Task AddContact(string address)
    {
        await ContactService.AddContactAsync(address);
    }

    private void ClearSelection() => _selectedThreadIds.Clear();

    private bool AllSelectedAreFavorited() =>
        _selectedThreadIds.Count > 0 &&
        _selectedThreadIds.All(id => ViewModel.Threads.FirstOrDefault(t => t.Id == id)?.IsFavorite == true);

    private async Task ToggleFavoriteSelectedThreads()
    {
        var ids = _selectedThreadIds.ToList();
        _selectedThreadIds.Clear();
        await ViewModel.FavoriteThreadsCommand.ExecuteAsync(ids);
    }

    private async Task ArchiveSelectedThreads()
    {
        var ids = _selectedThreadIds.ToList();
        _selectedThreadIds.Clear();
        await ViewModel.ArchiveThreadsCommand.ExecuteAsync(ids);
    }

    private async Task TrashSelectedThreads()
    {
        var ids = _selectedThreadIds.ToList();
        _selectedThreadIds.Clear();
        await ViewModel.TrashThreadsCommand.ExecuteAsync(ids);
    }

    private void OpenOverflowForSingleSelection()
    {
        if (_selectedThreadIds.Count != 1)
        {
            return;
        }

        var threadId = _selectedThreadIds.First();
        var thread = ViewModel.Threads.FirstOrDefault(t => t.Id == threadId);
        if (thread is null)
        {
            return;
        }

        _actionSheetThreadId = threadId;
        _actionSheetAddress = thread.Address;
        _actionSheetIsFavorite = thread.IsFavorite;
        _actionSheetIsUnread = thread.UnreadCount > 0;
    }
}
