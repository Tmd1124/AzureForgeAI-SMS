@page "/archived"
@inject SmsMessenger.Core.ViewModels.ArchivedViewModel ViewModel

<div style="padding:12px;">
    <h3>Archived</h3>

    @if (ViewModel.ArchivedThreads.Count == 0)
    {
        <p>No archived conversations.</p>
    }
    else
    {
        @foreach (var thread in ViewModel.ArchivedThreads)
        {
            <div style="padding:10px;border-bottom:1px solid #eee;display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <strong>@thread.DisplayNameOrAddress</strong>
                    <div style="color:#94a3b8;font-size:0.85em;">@thread.PreviewText</div>
                </div>
                <button @onclick="() => ViewModel.UnarchiveCommand.ExecuteAsync(thread.Id)">Unarchive</button>
            </div>
        }
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadCommand.ExecuteAsync(null);
    }
}
