@page "/conversations/thread"
@implements IDisposable
@inject IServiceProvider Services
@inject ForgeLinkSms.Core.Services.ICalendarService CalendarService
@inject ForgeLinkSms.Core.Services.NavigationHistoryTracker HistoryTracker
@using Microsoft.Extensions.DependencyInjection
@using ForgeLinkSms.Components
@using ForgeLinkSms.Core.Models
@using ForgeLinkSms.Core.Services
@using ForgeLinkSms.Core.Utils
@using ForgeLinkSms.Core.ViewModels

<style>
    .compose-grow-wrap {
        display: inline-grid;
        vertical-align: bottom;
    }
    .compose-grow-wrap::after {
        content: attr(data-replicated-value) " ";
        white-space: pre-wrap;
        visibility: hidden;
    }
    .compose-grow-wrap > textarea {
        resize: none;
        overflow-y: auto;
    }
    .compose-grow-wrap > textarea,
    .compose-grow-wrap::after {
        font: inherit;
        padding: 8px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 16px;
        grid-area: 1 / 1 / 2 / 2;
        max-height: 150px;
        line-height: 1.3;
    }
</style>

@if (ViewModel is not null)
{
    <div style="display:flex;flex-direction:column;height:100vh;">
        <div @onclick="OpenContact" style="padding:10px;background:var(--card-color);border-bottom:1px solid #eee;cursor:pointer;">@DisplayName</div>
        <div style="flex:1;overflow-y:auto;padding:8px;display:flex;flex-direction:column-reverse;">
            @* Rendered newest-first: paired with column-reverse, the browser's default scroll
               position lands on the newest message (bottom) without any JS interop, and stays
               pinned there as new messages arrive — same trick every chat UI uses.
               Date separators are emitted right after the message that starts a new day: since
               column-reverse fully flips DOM order into visual order, "after in this DOM loop"
               is "above it" on screen — i.e. exactly where a separator for that day belongs. *@
            @foreach (var (message, showDateSeparator) in MessagesWithDateSeparators().Reverse())
            {
                <div style="display:flex;flex-direction:column;align-items:@(message.IsOutgoing ? "flex-end" : "flex-start");margin:4px 4px;">
                    <div @onpointerdown="() => OnMessagePointerDown(message)"
                         @onpointerup="CancelMessageLongPress"
                         @onpointerleave="CancelMessageLongPress"
                         style="max-width:75%;padding:8px 12px;border-radius:16px;user-select:none;-webkit-user-select:none;background:@(message.IsOutgoing ? "var(--accent-color)" : "var(--card-color)");color:@(message.IsOutgoing ? "white" : "var(--text-color)");">
                        @foreach (var segment in MessageLinkParser.Parse(message.Body))
                        {
                            switch (segment.Kind)
                            {
                                case MessageLinkKind.Url:
                                    <span style="text-decoration:underline;cursor:pointer;" @onclick="() => OpenUrl(segment)">@segment.Text</span>
                                    break;
                                case MessageLinkKind.PhoneNumber:
                                    <span style="text-decoration:underline;cursor:pointer;" @onclick="() => CallNumber(segment)">@segment.Text</span>
                                    break;
                                case MessageLinkKind.Address:
                                    <span style="text-decoration:underline;cursor:pointer;" @onclick="() => OpenMap(segment)">@segment.Text</span>
                                    break;
                                case MessageLinkKind.Appointment:
                                    <span style="text-decoration:underline;cursor:pointer;" @onclick="() => OpenCalendarEvent(segment, message.Body)">@segment.Text</span>
                                    break;
                                default:
                                    @segment.Text
                                    break;
                            }
                        }
                        @foreach (var attachment in message.Attachments)
                        {
                            @if (attachment.DataUri is not null)
                            {
                                <img src="@attachment.DataUri" alt="@attachment.FileName" style="display:block;max-width:100%;max-height:240px;border-radius:10px;margin-top:@(string.IsNullOrEmpty(message.Body) ? "0" : "6px");" />
                            }
                            else
                            {
                                <div style="display:flex;align-items:center;gap:6px;margin-top:@(string.IsNullOrEmpty(message.Body) ? "0" : "6px");">
                                    <span>@(attachment.Kind == AttachmentKind.Video ? "🎬" : "📎")</span>
                                    <span style="text-decoration:underline;">@attachment.FileName</span>
                                </div>
                            }
                        }
                    </div>
                    <div style="font-size:0.75em;color:#94a3b8;margin-top:2px;">
                        @message.Timestamp.LocalDateTime.ToString("h:mm tt")
                        @if (!string.IsNullOrEmpty(message.StatusDisplay))
                        {
                            <span> · @message.StatusDisplay</span>
                        }
                    </div>
                </div>
                @if (showDateSeparator)
                {
                    <div style="text-align:center;color:#94a3b8;font-size:0.8em;margin:12px 0 4px;">
                        @FormatDateSeparator(DateOnly.FromDateTime(message.Timestamp.LocalDateTime))
                    </div>
                }
            }
        </div>
        <PendingAttachmentPreview Attachment="_pendingAttachment" OnRemove="() => _pendingAttachment = null" />
        <ScheduledSendPreview SendAt="_scheduledSendTime" OnRemove="() => _scheduledSendTime = null" />
        <div style="display:flex;align-items:flex-end;padding:8px;">
            <button @onclick="() => _drawer?.Open()"
                    style="width:40px;height:40px;border-radius:50%;border:none;background:var(--card-color);color:var(--text-color);font-size:1.4em;margin-right:8px;flex-shrink:0;">
                +
            </button>
            <div class="compose-grow-wrap" data-replicated-value="@ViewModel.ComposeText" style="flex:1;">
                <textarea placeholder="Text message" rows="1" spellcheck="true" autocorrect="on" autocapitalize="sentences"
                          @bind="ViewModel.ComposeText" @bind:event="oninput"></textarea>
            </div>
            @if (!string.IsNullOrWhiteSpace(ViewModel.ComposeText) && _pendingAttachment is null)
            {
                <button @onclick="SendOrSchedule"
                        style="width:40px;height:40px;border-radius:50%;border:none;background:#22c55e;color:white;font-size:1.2em;margin-left:8px;flex-shrink:0;">
                    ➤
                </button>
            }
        </div>
    </div>
}

<AttachmentDrawer @ref="_drawer" OnInsertText="InsertIntoCompose" OnAttachmentPicked="a => _pendingAttachment = a" OnScheduleTimePicked="t => _scheduledSendTime = t" />

@if (_reactionTargetMessage is not null)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.4);display:flex;align-items:flex-end;" @onclick="CloseReactionBar">
        <div style="background:var(--card-color);width:100%;padding:16px;border-radius:16px 16px 0 0;display:flex;justify-content:space-around;" @onclick:stopPropagation="true">
            @foreach (var emoji in ReactionEmojis)
            {
                <button @onclick="() => SendReaction(emoji)" style="border:none;background:transparent;font-size:2em;">@emoji</button>
            }
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public long ThreadId { get; set; }

    [SupplyParameterFromQuery(Name = "address")]
    public string Address { get; set; } = string.Empty;

    private ThreadDetailViewModel? ViewModel;
    private string DisplayName = string.Empty;
    private static readonly string[] ReactionEmojis = { "👍", "❤️", "😂", "😮", "😢", "🙏" };
    private ForgeLinkSms.Core.Models.SmsMessage? _reactionTargetMessage;
    private CancellationTokenSource? _messageLongPressCts;
    private ForgeLinkSms.Components.AttachmentDrawer? _drawer;
    private ForgeLinkSms.Core.Models.PickedAttachment? _pendingAttachment;
    private DateTimeOffset? _scheduledSendTime;
    private IContactService? _contactService;

    private async Task SendOrSchedule()
    {
        if (_scheduledSendTime is { } sendAt)
        {
            await ViewModel!.ScheduleSendCommand.ExecuteAsync(sendAt);
            _scheduledSendTime = null;
        }
        else
        {
            await ViewModel!.SendCommand.ExecuteAsync(null);
        }
    }

    private void InsertIntoCompose(string text)
    {
        ViewModel!.ComposeText = string.IsNullOrEmpty(ViewModel.ComposeText) ? text : $"{ViewModel.ComposeText}\n{text}";
    }

    protected override async Task OnInitializedAsync()
    {
        DisplayName = Address;
        _contactService = Services.GetRequiredService<IContactService>();
        var contact = await _contactService.LookupAsync(Address);
        if (contact is not null)
        {
            DisplayName = contact.DisplayName;
        }

        var smsService = Services.GetRequiredService<ISmsService>();
        var scheduler = Services.GetRequiredService<IMessageSchedulerService>();
        ViewModel = new ThreadDetailViewModel(smsService, scheduler, ThreadId, Address);
        await ViewModel.LoadCommand.ExecuteAsync(null);

        await Services.GetRequiredService<IMarkAsReadService>().MarkThreadAsReadAsync(ThreadId);

        HistoryTracker.LocalBackHandler = TryCloseReactionBarForBack;
    }

    // The hardware back button is fully intercepted at the native layer (see MainActivity) to fix
    // an unrelated bug, so it no longer reaches this overlay's own click-outside-to-close handler —
    // it must close the reaction picker itself instead of falling through to leaving the thread.
    private bool TryCloseReactionBarForBack()
    {
        if (_reactionTargetMessage is null)
        {
            return false;
        }

        CloseReactionBar();
        StateHasChanged();
        return true;
    }

    public void Dispose()
    {
        // Blazor's router can create the next page before disposing this one, so only clear the
        // handler if it's still ours — otherwise this would wipe out a registration the next page
        // already made.
        if (HistoryTracker.LocalBackHandler == TryCloseReactionBarForBack)
        {
            HistoryTracker.LocalBackHandler = null;
        }
    }

    private IEnumerable<(ForgeLinkSms.Core.Models.SmsMessage Message, bool ShowDateSeparator)> MessagesWithDateSeparators()
    {
        DateOnly? lastDate = null;
        foreach (var message in ViewModel!.Messages)
        {
            var date = DateOnly.FromDateTime(message.Timestamp.LocalDateTime);
            yield return (message, date != lastDate);
            lastDate = date;
        }
    }

    private static string FormatDateSeparator(DateOnly date)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        if (date == today)
        {
            return "Today";
        }
        if (date == today.AddDays(-1))
        {
            return "Yesterday";
        }
        return date.ToString("MMMM d, yyyy");
    }

    private void OnMessagePointerDown(ForgeLinkSms.Core.Models.SmsMessage message)
    {
        _messageLongPressCts = new CancellationTokenSource();
        var token = _messageLongPressCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(500, token);
                await InvokeAsync(() =>
                {
                    _reactionTargetMessage = message;
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException)
            {
                // pointer released or left before the long-press threshold — a normal tap, not a long-press
            }
        });
    }

    private void CancelMessageLongPress() => _messageLongPressCts?.Cancel();

    private void CloseReactionBar() => _reactionTargetMessage = null;

    private async Task SendReaction(string emoji)
    {
        if (_reactionTargetMessage is not null)
        {
            await ViewModel!.SendReactionCommand.ExecuteAsync((emoji, _reactionTargetMessage.Body));
        }
        CloseReactionBar();
    }

    private async Task OpenContact()
    {
        if (_contactService is not null)
        {
            await _contactService.OpenContactAsync(Address);
        }
    }

    private static async Task OpenUrl(MessageTextSegment segment)
    {
        if (segment.Data is string url)
        {
            await Launcher.Default.OpenAsync(new Uri(url));
        }
    }

    private static void CallNumber(MessageTextSegment segment)
    {
        if (segment.Data is string digits)
        {
            PhoneDialer.Default.Open(digits);
        }
    }

    private static async Task OpenMap(MessageTextSegment segment)
    {
        if (segment.Data is string address)
        {
            await Launcher.Default.OpenAsync(new Uri("geo:0,0?q=" + Uri.EscapeDataString(address)));
        }
    }

    private async Task OpenCalendarEvent(MessageTextSegment segment, string messageBody)
    {
        if (segment.Data is DateTime start)
        {
            await CalendarService.OpenNewEventAsync(messageBody, start, start.AddMinutes(30));
        }
    }
}
