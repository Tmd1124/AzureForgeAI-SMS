@page "/compose"
@inject ForgeLinkSms.Core.ViewModels.ComposeViewModel ViewModel
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@using ForgeLinkSms.Core.Models
@using ForgeLinkSms.Core.Utils

<style>
    .recipient-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--card-color);
        border-radius: 16px;
        padding: 3px 8px 3px 3px;
        margin: 2px 0;
    }

    .chip-avatar {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }

    .chip-avatar-fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--accent-color);
        color: white;
        font-size: 0.65em;
        font-weight: 600;
    }

    .chip-remove {
        cursor: pointer;
        color: #94a3b8;
        margin-left: 2px;
    }

    .contact-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-bottom: 1px solid #eee;
    }

    .contact-row:active {
        background: var(--card-color);
    }

    .compose-grow-wrap {
        display: inline-grid;
        vertical-align: bottom;
    }
    .compose-grow-wrap::after {
        content: attr(data-replicated-value) " ";
        white-space: pre-wrap;
        visibility: hidden;
    }
    .compose-grow-wrap > textarea {
        resize: none;
        overflow-y: auto;
    }
    .compose-grow-wrap > textarea,
    .compose-grow-wrap::after {
        font: inherit;
        padding: 8px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 16px;
        grid-area: 1 / 1 / 2 / 2;
        max-height: 150px;
        line-height: 1.3;
    }
</style>

<div style="display:flex;flex-direction:column;height:100vh;">
    <div style="padding:10px;background:var(--card-color);border-bottom:1px solid #eee;font-weight:600;">New Message</div>

    <div style="padding:6px 12px;border-bottom:1px solid #eee;display:flex;align-items:center;flex-wrap:wrap;gap:4px;">
        <span style="color:#94a3b8;font-size:0.9em;">To:</span>
        @foreach (var recipient in ViewModel.Recipients)
        {
            var contact = ViewModel.FindContact(recipient);
            <span class="recipient-chip">
                @if (!string.IsNullOrEmpty(contact?.PhotoUri))
                {
                    <img src="@contact.PhotoUri" class="chip-avatar" />
                }
                else
                {
                    <span class="chip-avatar chip-avatar-fallback">@(contact?.Initials ?? "#")</span>
                }
                @(contact?.DisplayName ?? PhoneNumberFormatter.ToDisplayFormat(recipient))
                <span class="chip-remove" @onclick="() => ViewModel.RemoveRecipientCommand.Execute(recipient)">✕</span>
            </span>
        }
        <input placeholder="@(ViewModel.Recipients.Count == 0 ? "Name or phone number" : "Add another")"
               style="flex:1;min-width:100px;border:none;outline:none;background:transparent;font-size:1em;padding:6px 0;color:var(--text-color);"
               @bind="ViewModel.SearchText" @bind:event="oninput" @onkeyup="OnRecipientKeyUp" />
    </div>

    @if (ViewModel.IsGroupSend)
    {
        <p style="color:#92400e;background:#fef3c7;padding:8px 12px;margin:0;font-size:0.85em;">Sending to @ViewModel.Recipients.Count people individually — they won't see each other or each other's replies.</p>
    }

    @if (ViewModel.IsMultiSelecting)
    {
        <div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--card-color);border-bottom:1px solid #eee;">
            <span class="chip-remove" style="font-size:1.2em;" @onclick="() => ViewModel.CancelMultiSelectCommand.Execute(null)">✕</span>
            <strong style="flex:1;">@ViewModel.SelectedCount selected</strong>
            <button style="border:none;background:var(--accent-color);color:white;border-radius:16px;padding:6px 14px;font-size:0.9em;"
                    @onclick="() => ViewModel.ConfirmMultiSelectCommand.Execute(null)">
                Add
            </button>
        </div>
    }

    @if (ShowContactList)
    {
        <div style="flex:1;overflow-y:auto;">
            @if (ViewModel.FilteredContacts.Count == 0)
            {
                <p style="text-align:center;color:#94a3b8;padding:24px 12px;">No matching contacts. Keep typing a full number to text it directly.</p>
            }
            else
            {
                @foreach (var contact in ViewModel.FilteredContacts)
                {
                    <div class="contact-row"
                         @onpointerdown="() => OnContactPointerDown(contact)"
                         @onpointerup="() => OnContactPointerUp(contact)"
                         @onpointerleave="CancelContactLongPress">
                        @if (ViewModel.IsMultiSelecting)
                        {
                            <div style="width:40px;height:40px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.3em;background:@(ViewModel.IsContactSelected(contact) ? "var(--accent-color)" : "transparent");border:2px solid var(--accent-color);color:white;">
                                @(ViewModel.IsContactSelected(contact) ? "✓" : "")
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(contact.PhotoUri))
                        {
                            <img src="@contact.PhotoUri" style="width:40px;height:40px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                        }
                        else
                        {
                            <div style="width:40px;height:40px;border-radius:50%;background:var(--accent-color);color:white;display:flex;align-items:center;justify-content:center;flex-shrink:0;">@contact.Initials</div>
                        }
                        <div>
                            <div>@contact.DisplayName</div>
                            <div style="font-size:0.8em;color:#94a3b8;">@PhoneNumberFormatter.ToDisplayFormat(contact.PhoneNumber)</div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div style="flex:1;"></div>
    }

    <div style="display:flex;align-items:flex-end;padding:8px;border-top:1px solid #eee;">
        <div class="compose-grow-wrap" data-replicated-value="@ViewModel.MessageBody" style="flex:1;">
            <textarea placeholder="Text message" rows="1" spellcheck="true" autocorrect="on" autocapitalize="sentences"
                      @bind="ViewModel.MessageBody" @bind:event="oninput"></textarea>
        </div>
        @if (!string.IsNullOrWhiteSpace(ViewModel.MessageBody))
        {
            <button @onclick="() => ViewModel.SendCommand.ExecuteAsync(null)"
                    style="width:40px;height:40px;border-radius:50%;border:none;background:#22c55e;color:white;font-size:1.2em;margin-left:8px;flex-shrink:0;">
                ➤
            </button>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "add")]
    public string? AddParam { get; set; }

    private bool ShowContactList => ViewModel.IsMultiSelecting || ViewModel.Recipients.Count == 0 || !string.IsNullOrWhiteSpace(ViewModel.SearchText);

    private bool _longPressTriggered;
    private CancellationTokenSource? _longPressCts;

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadContactsCommand.ExecuteAsync(null);
    }

    private void OnContactPointerDown(ContactInfo contact)
    {
        _longPressTriggered = false;
        _longPressCts = new CancellationTokenSource();
        var token = _longPressCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(500, token);
                _longPressTriggered = true;
                await InvokeAsync(() =>
                {
                    ViewModel.BeginMultiSelectCommand.Execute(contact);
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException)
            {
                // pointer released or left before the long-press threshold — a normal tap, not a long-press
            }
        });
    }

    private void CancelContactLongPress() => _longPressCts?.Cancel();

    private void OnContactPointerUp(ContactInfo contact)
    {
        _longPressCts?.Cancel();
        if (_longPressTriggered)
        {
            return;
        }

        if (ViewModel.IsMultiSelecting)
        {
            ViewModel.ToggleContactSelectionCommand.Execute(contact);
        }
        else
        {
            ViewModel.SelectContactCommand.Execute(contact);
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(AddParam))
        {
            ViewModel.AddRecipientCommand.Execute(AddParam);
        }
    }

    private void OnRecipientKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(ViewModel.SearchText))
        {
            ViewModel.AddRecipientCommand.Execute(ViewModel.SearchText);
            ViewModel.SearchText = string.Empty;
        }
    }
}
